<HxOffcanvas @ref="sessionDetailOffCanvasComponent" Title="Edit" 
             Backdrop="OffcanvasBackdrop.Static"
             OnClosed="HandleClosed">
    <BodyTemplate>
        <h5>@Model.Name</h5>
        
        <EditForm Id="@FormId" Model="@Model" OnValidSubmit="@(async () => { await SaveResolution(); })">
            <DataAnnotationsValidator />
            <ValidationSummary />
            
            <HxInputText Label="Název" @bind-value="Model.Name"></HxInputText>
            <HxInputDate Label="Datum" @bind-Value="Model.Date"></HxInputDate>

        </EditForm>
    </BodyTemplate>
    <FooterTemplate>
        <HxSubmit Color="ThemeColor.Primary" FormId="@FormId" Icon="BootstrapIcon.Save">Uložit</HxSubmit>
    </FooterTemplate>
</HxOffcanvas>