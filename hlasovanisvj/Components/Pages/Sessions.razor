@page "/"

@using System.Drawing
@using hlasovanisvj.Domain
@attribute [Authorize]

<HxListLayout Title="Schůze" TFilterModel="SessionFilter"
              @bind-FilterModel="filterModel"
              @bind-FilterModel:after="gridComponent.RefreshDataAsync">
	<CommandsTemplate>
		<HxButton Text="Nová schůze"
		          Color="ThemeColor.Primary"
		          Icon="BootstrapIcon.Plus" OnClick="HandleNewSessionClick"/>
	</CommandsTemplate>
	<FilterTemplate Context="filterContext">
		<HxInputText Label="Session" @bind-Value="filterContext.Name"/>
	</FilterTemplate>
	<DataTemplate>
		<HxGrid @ref="gridComponent"
		        ContentNavigationMode="GridContentNavigationMode.InfiniteScroll"
		        TableContainerCssClass="scrollable-table-container"
		        HeaderRowCssClass="sticky-top"
		        FooterRowCssClass="sticky-bottom"
		        TItem="Session"
		        DataProvider="GetGridData"
		        @bind-SelectedDataItem="currentSession"
		        @bind-SelectedDataItem:after="HandleSelectedDataItemChanged"
		        Responsive="true">
			<Columns>
				<HxGridColumn HeaderText="Date"
				              ItemTextSelector="@(p => $"{p.Date}")"
				              SortKeySelector="p => p.Date"
				              IsDefaultSortColumn="true"/>
				<HxGridColumn HeaderText="Název"
				              ItemTextSelector="@(p => p.Name)"
				              SortKeySelector="p => p.Name"
				              IsDefaultSortColumn="true"/>
				<HxGridColumn HeaderText="Akce">
					
					<ItemTemplate Context="item">
						@if(currentSessionId != item.Id)
						{
							<HxButton Color="ThemeColor.Primary"
							          Text="Otevřít schůzi"
							          OnClick="@(() => HandleOpenSessionButtonClick(item.Id))"></HxButton>
						}
						else
						{ 
							<HxBadge Color="ThemeColor.Success">Aktivní</HxBadge>
						}
					</ItemTemplate>
				</HxGridColumn>
				<HxGridColumn HeaderText="Smazat">
					<ItemTemplate Context="item">
						<HxButton Icon="BootstrapIcon.Trash"
						          OnClick="@(() => HandleDeleteSessionButtonClick(item.Id))">
						</HxButton>
					</ItemTemplate>
				</HxGridColumn>
			</Columns>
		</HxGrid>
	</DataTemplate>
	<DetailTemplate>
		
	</DetailTemplate>
</HxListLayout>

<SessionDetail @ref="sessionDetail" OnClosed="HandleDetailClosed"></SessionDetail>