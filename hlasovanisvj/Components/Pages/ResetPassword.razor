@page "/ResetPassword"
@using hlasovanisvj.Models
@using hlasovanisvj.Services
@inject PasswordResetService PasswordResetService
@layout Layout.LandingLayout
<div class="container py-5" style="max-width: 480px">
    <div class="card shadow-sm">
        <div class="card-body p-4">
            <h1 class="h4 mb-3">Nové heslo</h1>

            @if (done)
            {
                <HxAlert Color="ThemeColor.Success">Heslo bylo změněno. Nyní se můžete přihlásit.</HxAlert>
                <a class="btn btn-primary" href="login?loggedout=1">Přihlásit</a>
            }
            else if (Uid == null || string.IsNullOrEmpty(Token))
            {
                <HxAlert Color="ThemeColor.Danger">Neplatný odkaz.</HxAlert>
                <a href="ForgotPassword">Požádat o nový odkaz</a>
            }
            else
            {
                @if (failed)
                {
                    <HxAlert Color="ThemeColor.Danger">
                        Odkaz je neplatný nebo vypršel. <a href="ForgotPassword">Požádejte o nový.</a>
                    </HxAlert>
                }
                <EditForm Model="@model" OnValidSubmit="@Submit">
                    <DataAnnotationsValidator/>
                    <HxInputText Type="InputType.Password" Label="Nové heslo" @bind-Value="model.Password"/>
                    <HxInputText Type="InputType.Password" Label="Nové heslo znovu" @bind-Value="model.Password2"/>
                    <HxSubmit Color="ThemeColor.Primary">Nastavit heslo</HxSubmit>
                </EditForm>
            }
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public int? Uid { get; set; }
    [SupplyParameterFromQuery] public string? Token { get; set; }

    private readonly ResetPasswordModel model = new();
    private bool done;
    private bool failed;

    private async Task Submit()
    {
        failed = false;
        done = await PasswordResetService.ResetPasswordAsync(Uid!.Value, Token!, model.Password);
        failed = !done;
    }
}
