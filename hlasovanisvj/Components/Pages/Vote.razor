@page "/Vote"
@using hlasovanisvj.Components.Layout
@layout VoteLayout

@if(_resolution != null && _member != null)
{
    <HxCard CssClass="text-center" FooterCssClass="text-muted">
        <HeaderTemplate>Hlasujte</HeaderTemplate>
        <BodyTemplate>
            <HxCardTitle>@_resolution?.Title</HxCardTitle>
            <HxCardText>@_resolution?.Question</HxCardText>
            <HxButton @ref="btnInFavor" 
                      Color="ThemeColor.Success"
                      Text="Jsem pro"
                      CssClass="w-100"
                      OnClick="HandleInFavorClick" />

            <br/><br/>
            
            <HxButton @ref="btnAgainst"  
                      Color="ThemeColor.Danger"
                      Text="Jsem proti"
                      CssClass="w-100"
                      OnClick="HandleAgainstClick" />

            <br/><br/>
            
            <HxButton @ref="btnAbstained" 
                      Color="ThemeColor.Warning"
                      Text="Zdržuji se"
                      CssClass="w-100"
                      OnClick="HandleAbstainedClick" />
        </BodyTemplate>
        <FooterTemplate>
            @_member?.Name
        </FooterTemplate>
    </HxCard>
}
else
{
    <HxIcon Icon="BootstrapIcon.QuestionCircle" Size="IconSize.Large" CssClass="me-2" />
}



