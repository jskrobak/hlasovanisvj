@page "/ForgotPassword"
@using hlasovanisvj.Models
@using hlasovanisvj.Services
@inject PasswordResetService PasswordResetService

<h3>Zapomenuté heslo</h3>

@if (sent)
{
    <HxAlert Color="ThemeColor.Success">
        Pokud k e-mailu <strong>@model.Email</strong> existuje účet, poslali jsme na něj odkaz pro nastavení nového hesla.
        Odkaz platí 1 hodinu.
    </HxAlert>
    <a href="login?loggedout=1">Zpět na přihlášení</a>
}
else
{
    <p>Zadejte e-mail, se kterým jste se registrovali. Pošleme vám odkaz pro nastavení nového hesla.</p>
    <EditForm Model="@model" OnValidSubmit="@Submit">
        <DataAnnotationsValidator/>
        <HxInputText Type="InputType.Email" Label="E-mail" @bind-Value="model.Email"/>
        <HxSubmit Color="ThemeColor.Primary" Enabled="@(!busy)">Poslat odkaz</HxSubmit>
    </EditForm>
}

@code {
    private readonly ForgotPasswordModel model = new();
    private bool sent;
    private bool busy;

    private async Task Submit()
    {
        busy = true;
        await PasswordResetService.RequestResetAsync(model.Email);
        sent = true;
        busy = false;
    }
}
