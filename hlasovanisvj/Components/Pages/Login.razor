@page "/Login"
@layout Layout.LandingLayout

<div class="container py-5" style="max-width: 440px">
    <div class="card shadow-sm">
        <div class="card-body p-4">
            <h1 class="h4 mb-3">Přihlášení</h1>

            @if (googleError)
            {
                <HxAlert Color="ThemeColor.Danger">Přihlášení přes Google se nezdařilo.</HxAlert>
            }

            <LoginForm ReturnUrl="@returnUrl"/>

            <p class="mt-4 mb-0 small text-body-secondary">
                Nemáte účet? <a href="Register">Zaregistrujte se</a>.
            </p>
        </div>
    </div>
</div>
