@inherits LayoutComponentBase

<HxMessenger Position="ToastContainerPosition.BottomCenter" />
<HxMessageBoxHost />

<div class="d-flex flex-column min-vh-100">
    <header class="landing-header border-bottom bg-body">
        <nav class="container d-flex align-items-center gap-2 py-3">
            <a href="./" class="d-flex align-items-center gap-2 text-decoration-none text-body me-auto">
                <span class="brand-mark">SVJ</span>
                <span class="fw-semibold fs-5">Schůze SVJ</span>
            </a>
            <AuthorizeView>
                <Authorized>
                    <a class="btn btn-primary" href="Sessions">Moje schůze</a>
                </Authorized>
                <NotAuthorized>
                    <a class="btn btn-link text-decoration-none d-none d-sm-inline-block" href="Login">Přihlásit</a>
                    <a class="btn btn-primary" href="Register">Registrace</a>
                </NotAuthorized>
            </AuthorizeView>
        </nav>
    </header>

    <main class="flex-grow-1">
        @Body
    </main>

    <footer class="border-top py-4 text-body-secondary small">
        <div class="container d-flex flex-wrap justify-content-between gap-2">
            <span>© @DateTime.Now.Year Schůze SVJ</span>
            <span>Hlasování na shromáždění společenství vlastníků jednotek</span>
        </div>
    </footer>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
